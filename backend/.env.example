PORT=4000
JWT_SECRET=change_this_to_a_long_random_string
CONTENT_ENCRYPTION_KEY=change_this_to_a_32_byte_hex_key_1234
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=ChangeMe123!
# Comma-separated list of allowed frontend origins (no spaces needed, trimmed automatically).
# 5173 = npm run dev, 4173 = npm run preview (needed to test the PWA install button).
# In production, replace with your real deployed frontend URL(s), e.g. https://your-app.vercel.app
FRONTEND_ORIGIN=http://localhost:5173,http://localhost:4173

# --- Notifikasi Email (opsional) ---
# Ada 2 cara, pilih SALAH SATU:
#
# CARA 1 (direkomendasikan): Resend
# Daftar gratis di https://resend.com, dapat 1 API key, tempel di bawah.
# Tidak perlu App Password/2FA/generate SMTP key. Didesain khusus untuk
# dipanggil dari backend server (beda dari Web3Forms yang cuma untuk
# browser dan akan ditolak/403 kalau dipanggil dari server).
# CATATAN: tanpa verifikasi domain sendiri di Resend, kamu hanya bisa
# mengirim ke email yang kamu pakai daftar akun Resend. Untuk kirim ke
# email admin manapun secara bebas, perlu verifikasi domain (untuk
# penggunaan produksi beneran, bukan wajib untuk testing/development).
RESEND_API_KEY=
#
# CARA 2: SMTP custom (Gmail, Brevo, dll) — dipakai OTOMATIS kalau
# RESEND_API_KEY di atas dikosongkan. Kalau pakai cara ini, isi semua
# baris di bawah (kalau salah satu kosong, notifikasi tidak akan dikirim
# dan backend akan menampilkan warning di terminal saat startup), dan
# ADMIN_NOTIFICATION_EMAIL menentukan ke mana notifikasi dikirim.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Sistem Pengaduan Sekolah <your_email@example.com>"
ADMIN_NOTIFICATION_EMAIL=admin_sekolah@example.com
#
# Dipakai di isi email notifikasi (link ke dashboard), untuk KEDUA cara:
ADMIN_DASHBOARD_URL=http://localhost:5173/admin/dashboard
